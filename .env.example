# Local Postgres, started via `docker compose up -d`
DATABASE_URL="postgresql://dovetail:dovetail@localhost:5432/dovetailclone?schema=public"

# Storage driver: "local" stores uploads on disk under STORAGE_LOCAL_DIR
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/uploads"

# Required for AI features (tag suggestions, summarization). Leave unset to disable AI features.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL_TAGGING="claude-haiku-4-5-20251001"
ANTHROPIC_MODEL_SUMMARIZE="claude-sonnet-5"

# Required for video/audio transcription (speaker-labeled transcripts feeding
# highlight reels). Leave unset to disable the Transcribe button.
ASSEMBLYAI_API_KEY=""

# Auth (Better Auth). BETTER_AUTH_SECRET signs sessions - generate with
# `openssl rand -hex 32` (or similar) for a real deployment.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Optional OAuth providers. Leave unset to hide that sign-in button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
