# Local Postgres, started via `docker compose up -d`
DATABASE_URL="postgresql://willard:willard@localhost:5432/willard?schema=public"

# Storage driver: "local" stores uploads on disk under STORAGE_LOCAL_DIR;
# "s3" stores uploads in an S3 bucket (requires AWS_S3_BUCKET/AWS_REGION
# below, and either an IAM role in production or
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY for local testing -- the AWS SDK's
# default credential provider chain picks either up automatically).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/uploads"
AWS_S3_BUCKET=""
AWS_REGION="us-east-1"
# Only needed for local testing against a real bucket -- in production, use
# an IAM role instead and leave these unset.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Required for AI features (tag suggestions, summarization). Leave unset to disable AI features.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL_TAGGING="claude-haiku-4-5-20251001"
ANTHROPIC_MODEL_SUMMARIZE="claude-sonnet-4-6"

# Required for video/audio transcription (speaker-labeled transcripts feeding
# highlight reels). Leave unset to disable the Transcribe button.
ASSEMBLYAI_API_KEY=""

# Required for semantic search (ask-your-research chat, contradiction
# detection). Postgres must have the pgvector extension installed (the
# docker-compose Postgres image already includes it). Leave unset to disable
# these AI features.
VOYAGE_API_KEY=""
VOYAGE_MODEL_EMBED="voyage-4-lite"

# Auth (Better Auth). BETTER_AUTH_SECRET signs sessions - generate with
# `openssl rand -hex 32` (or similar) for a real deployment.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Required to send real emails (password reset, email verification, org
# invites) via AWS SES -- must be a verified sender identity in SES. Leave
# unset to fall back to logging the email content/link to the console
# (dev-only visibility, no actual email sent).
EMAIL_FROM_ADDRESS=""

# Optional OAuth providers. Leave unset to hide that sign-in button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
