// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Auth (Better Auth — generated shape, do not hand-edit field names) ──

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  projects      Project[]
  projectShares ProjectShare[]

  members     Member[]
  invitations Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ── Core hierarchy ─────────────────────────────────────────────

enum ProjectRole {
  VIEWER
  EDITOR
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Nullable: a project can be purely personal, outside any organization.
  // Chosen at creation time and immutable afterward (no "move to org" in v1).
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  orgShareEnabled Boolean     @default(false)
  orgShareRole    ProjectRole @default(VIEWER)

  shareLinkEnabled Boolean     @default(false)
  shareLinkToken   String?     @unique
  shareLinkRole    ProjectRole @default(VIEWER)

  shares ProjectShare[]

  notes          Note[]
  insights       Insight[]
  tags           Tag[]
  fields         Field[]
  views          View[]
  teamMembers    TeamMember[]
  highlightReels HighlightReel[]
  themes         Theme[]

  @@index([userId])
  @@index([organizationId])
}

model ProjectShare {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole
  createdAt DateTime    @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model Note {
  id           String                   @id @default(cuid())
  projectId    String
  project      Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String                   @default("Untitled")
  content      Json
  plainText    String                   @default("")
  /// generated column populated by migration SQL, not written to directly
  searchVector Unsupported("tsvector")?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  attachments    Attachment[]
  highlights     Highlight[]
  fieldValues    NoteFieldValue[]
  tagAssignments NoteTag[]

  @@index([projectId])
}

enum AttachmentKind {
  VIDEO
  AUDIO
  IMAGE
  FILE
}

enum TranscriptionStatus {
  NONE
  PENDING
  PROCESSING
  DONE
  FAILED
}

model Attachment {
  id           String         @id @default(cuid())
  noteId       String
  note         Note           @relation(fields: [noteId], references: [id], onDelete: Cascade)
  kind         AttachmentKind
  originalName String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  createdAt    DateTime       @default(now())

  transcriptionStatus TranscriptionStatus @default(NONE)
  transcriptionError  String?
  /// { [speakerLabel: string]: teamMemberId }
  speakerMap          Json?

  clipHighlights Highlight[]

  @@index([noteId])
}

model Highlight {
  id           String                   @id @default(cuid())
  noteId       String
  note         Note                     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  markId       String?
  wholeNote    Boolean                  @default(false)
  quote        String
  orphaned     Boolean                  @default(false)
  order        Int                      @default(0)
  /// generated column populated by migration SQL, not written to directly
  searchVector Unsupported("tsvector")?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  attachmentId String?
  attachment   Attachment? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  clipStartSec Float?
  clipEndSec   Float?
  /// cached storage key for the extracted-frame clip thumbnail, generated
  /// lazily by GET /api/highlights/[id]/thumbnail on first request
  thumbnailStorageKey String?

  tagAssignments HighlightTag[]
  insightLinks   InsightHighlight[]
  themeLinks     ThemeHighlight[]

  @@unique([noteId, markId])
  @@index([noteId])
  @@index([attachmentId])
}

model Insight {
  id           String                   @id @default(cuid())
  projectId    String
  project      Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String                   @default("Untitled insight")
  content      Json
  plainText    String                   @default("")
  /// generated column populated by migration SQL, not written to directly
  searchVector Unsupported("tsvector")?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  highlightLinks InsightHighlight[]
  fieldValues    InsightFieldValue[]

  @@index([projectId])
}

model InsightHighlight {
  insightId   String
  insight     Insight   @relation(fields: [insightId], references: [id], onDelete: Cascade)
  highlightId String
  highlight   Highlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)

  @@id([insightId, highlightId])
}

model Theme {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  highlightLinks ThemeHighlight[]

  @@index([projectId])
}

model ThemeHighlight {
  themeId     String
  theme       Theme     @relation(fields: [themeId], references: [id], onDelete: Cascade)
  highlightId String
  highlight   Highlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)

  @@id([themeId, highlightId])
}

// ── Tags ───────────────────────────────────────────────────────

model Tag {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Tag?    @relation("TagGroup", fields: [parentId], references: [id], onDelete: SetNull)
  children  Tag[]   @relation("TagGroup")
  name      String
  color     String

  noteAssignments      NoteTag[]
  highlightAssignments HighlightTag[]
  highlightReels       HighlightReel[]

  @@unique([projectId, name])
}

model NoteTag {
  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
}

model HighlightTag {
  highlightId String
  highlight   Highlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  tagId       String
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([highlightId, tagId])
}

enum HighlightReelStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model HighlightReel {
  id           String              @id @default(cuid())
  projectId    String
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tagId        String
  tag          Tag                 @relation(fields: [tagId], references: [id], onDelete: Cascade)
  name         String
  status       HighlightReelStatus @default(PENDING)
  storageKey   String?
  errorMessage String?
  createdAt    DateTime            @default(now())

  @@index([tagId])
  @@index([projectId])
}

// ── Fields (custom metadata) ────────────────────────────────────

enum FieldType {
  TEXT
  NUMBER
  SINGLE_SELECT
  MULTI_SELECT
  PERSON
  DATE
}

enum FieldAppliesTo {
  NOTE
  INSIGHT
  BOTH
}

model Field {
  id        String         @id @default(cuid())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  type      FieldType
  appliesTo FieldAppliesTo @default(BOTH)
  order     Int            @default(0)

  options        FieldOption[]
  noteValues     NoteFieldValue[]
  insightValues  InsightFieldValue[]
  viewsGroupedBy View[]              @relation("GroupByField")
  viewsSortedBy  View[]              @relation("SortField")

  @@unique([projectId, name])
}

model FieldOption {
  id      String @id @default(cuid())
  fieldId String
  field   Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  label   String
  color   String
  order   Int    @default(0)

  noteValueLinks    NoteFieldValueOption[]
  insightValueLinks InsightFieldValueOption[]
}

model TeamMember {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String

  noteValues    NoteFieldValue[]
  insightValues InsightFieldValue[]
}

model NoteFieldValue {
  id              String                 @id @default(cuid())
  noteId          String
  note            Note                   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  fieldId         String
  field           Field                  @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  valueText       String?
  valueNumber     Float?
  valueDate       DateTime?
  teamMemberId    String?
  teamMember      TeamMember?            @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
  selectedOptions NoteFieldValueOption[]

  @@unique([noteId, fieldId])
}

model NoteFieldValueOption {
  noteFieldValueId String
  noteFieldValue   NoteFieldValue @relation(fields: [noteFieldValueId], references: [id], onDelete: Cascade)
  fieldOptionId    String
  fieldOption      FieldOption    @relation(fields: [fieldOptionId], references: [id], onDelete: Cascade)

  @@id([noteFieldValueId, fieldOptionId])
}

model InsightFieldValue {
  id              String                    @id @default(cuid())
  insightId       String
  insight         Insight                   @relation(fields: [insightId], references: [id], onDelete: Cascade)
  fieldId         String
  field           Field                     @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  valueText       String?
  valueNumber     Float?
  valueDate       DateTime?
  teamMemberId    String?
  teamMember      TeamMember?               @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
  selectedOptions InsightFieldValueOption[]

  @@unique([insightId, fieldId])
}

model InsightFieldValueOption {
  insightFieldValueId String
  insightFieldValue   InsightFieldValue @relation(fields: [insightFieldValueId], references: [id], onDelete: Cascade)
  fieldOptionId       String
  fieldOption         FieldOption       @relation(fields: [fieldOptionId], references: [id], onDelete: Cascade)

  @@id([insightFieldValueId, fieldOptionId])
}

// ── Views ────────────────────────────────────────────────────────

enum ViewEntityType {
  NOTE
  HIGHLIGHT
  INSIGHT
}

enum ViewLayout {
  GRID
  BOARD
  TABLE
  CANVAS
  LIST
}

model View {
  id             String         @id @default(cuid())
  projectId      String
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  entityType     ViewEntityType
  layout         ViewLayout
  groupByFieldId String?
  groupByField   Field?         @relation("GroupByField", fields: [groupByFieldId], references: [id], onDelete: SetNull)
  sortFieldId    String?
  sortField      Field?         @relation("SortField", fields: [sortFieldId], references: [id], onDelete: SetNull)
  sortDirection  String?
  filterConfig   Json           @default("[]")
  order          Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  cardPositions CanvasCardPosition[]

  @@unique([projectId, name])
}

enum CanvasSubjectType {
  NOTE
  HIGHLIGHT
  INSIGHT
}

model CanvasCardPosition {
  id          String            @id @default(cuid())
  viewId      String
  view        View              @relation(fields: [viewId], references: [id], onDelete: Cascade)
  subjectType CanvasSubjectType
  subjectId   String
  x           Float
  y           Float
  width       Float?
  height      Float?
  zIndex      Int               @default(0)

  @@unique([viewId, subjectType, subjectId])
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  projects    Project[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}
